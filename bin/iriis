#!/usr/bin/env bash
# Iriis CLI for Git Bash / Linux / macOS. Add this folder to PATH, then: iriis status
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -x "$DIR/.venv/Scripts/python.exe" ]; then PY="$DIR/.venv/Scripts/python.exe"
elif [ -x "$DIR/.venv/bin/python" ]; then PY="$DIR/.venv/bin/python"
else echo "iriis: no virtualenv at $DIR/.venv (see README: Quick start)" >&2; exit 1; fi
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" PYTHONIOENCODING=utf-8
exec "$PY" -m iriis.cli "$@"
