# Iriis configuration. Never commit real values.
#   Railway (her brain): set the RAILWAY section as service Variables.
#   Your PC (desktop + CLI): run `iriis setup`, which writes the PC section to .env for you.
# IRIIS_API_KEY and IRIIS_DESKTOP_TOKEN must be IDENTICAL in both places.

# ============================== RAILWAY ==============================

# LLM brain: DeepSeek by default. Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Her expressive voice (Orpheus via Groq: real emotion). Key: https://console.groq.com/keys
# Accept the model terms once: https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# Without it she uses Kokoro (calm, on the server's CPU). The same key can also run the LLM on Groq.
GROQ_API_KEY=

# Postgres for memories, notes, reminders and the audit log.
# On Railway use the reference variable exactly as written:  ${{Postgres.DATABASE_URL}}
# Leave unset locally to use SQLite (data/iriis.sqlite3).
DATABASE_URL=

# Clients calling Iriis (REST, SSE, voice WebSocket, MCP) send: Authorization: Bearer <this>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
IRIIS_API_KEY=

# Separate secret for the desktop agent link. It grants access to your PC, so keep it different.
IRIIS_DESKTOP_TOKEN=

# Optional overrides: IRIIS__<SECTION>__<KEY>=value (YAML-parsed), e.g.
# IRIIS__LLM__MODEL=deepseek-v4-pro
# IRIIS__TTS__VOICE=bf_emma
# IRIIS__STT__MODEL=models/stt/afrispeech-whisper-medium-ct2

# ============================== YOUR PC ==============================

# Where her brain lives (the CLI and desktop agent connect here).
IRIIS_SERVER_URL=https://iriis-voice-production.up.railway.app
# ...plus the same IRIIS_API_KEY and IRIIS_DESKTOP_TOKEN as above.
